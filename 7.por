programa {
  funcao inicio() {

    real nota1
    real nota2
    real nota3
    real nota4

    escreva("Informe sua primeira nota: ")
    leia(nota1)

    escreva("Informe sua segunda nota: ")
    leia(nota2)

    escreva("Informe sua terceira nota: ")
    leia(nota3)

    escreva("Informe sua quarta nota: ")
    leia(nota4)

    escreva("Sua média de notas é: ", (nota1 + nota2 + nota3 + nota4) / 4 )

  }
}
